#!/bin/bash

# 1. Get the actual currently connected outputs
SAIDAS=$(pactl list short sinks | awk '{print $2}')

# 2. Create a friendly list based on what is actually connected
OPCOES=""
echo "$SAIDAS" | grep -q "MCHOSE_V9_PRO" && OPCOES+="🎧 MCHOSE V9 PRO\n"
echo "$SAIDAS" | grep -q "Speaker"       && OPCOES+="🔊 Speaker\n"
echo "$SAIDAS" | grep -E -q "buds|bluez" && OPCOES+="🎵 Buds 2\n"

# 3. Open Wofi with clean names (remove the last empty newline)
ESCOLHA=$(echo -e -n "$OPCOES" | wofi --dmenu --prompt "Selecione a saída de áudio:")

# 4. Convert the friendly nickname back to the system's technical name
case "$ESCOLHA" in
    *"MCHOSE V9 PRO"*)
        ALVO=$(echo "$SAIDAS" | grep "MCHOSE_V9_PRO")
        ;;
    *"Speaker"*)
        ALVO=$(echo "$SAIDAS" | grep "Speaker")
        ;;
    *"Buds 2"*)
        ALVO=$(echo "$SAIDAS" | grep -E "buds|bluez")
        ;;
    *)
        ALVO=""
        ;;
esac

# 5. Apply the change if the user selected a valid option
if [ ! -z "$ALVO" ]; then
    pactl set-default-sink "$ALVO"
fi
